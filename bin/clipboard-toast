#!/usr/bin/env python3
"""
clipboard-toast - Fast, unified Wayland clipboard copy toast notification handler.
Invoked by wl-paste --watch. Triggers KDE Plasma OSD pill and tmux status toast.
"""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

STATE_FILE = f"/tmp/clipboard_toast_last_hash_{os.getuid()}"


def main() -> None:
    # 1. State check from wl-paste
    clip_state = os.environ.get("CLIPBOARD_STATE", "data").lower()
    if clip_state in ("clear", "nil"):
        sys.exit(0)

    # 2. Read stdin bytes (up to 64KB)
    try:
        content = sys.stdin.read(65536)
    except Exception:
        content = ""

    # If stdin was empty, try reading directly from wl-paste
    if not content:
        try:
            wl_bin = shutil.which("wl-paste") or os.path.expanduser("~/.local/bin/wl-paste")
            res = subprocess.run(
                [wl_bin, "-n"],
                capture_output=True,
                text=True,
                timeout=0.5,
                check=False,
            )
            if res.returncode == 0:
                content = res.stdout[:65536]
        except Exception:
            pass

    if not content or "\x00" in content or not content.strip():
        sys.exit(0)

    # 3. Hash content & check debounce
    now = time.time()
    content_hash = hashlib.sha256(content.encode("utf-8", errors="replace")).hexdigest()

    is_first_boot = not os.path.exists(STATE_FILE)
    if is_first_boot:
        # Initial run on daemon startup: record state without firing toast
        try:
            with open(STATE_FILE, "w", encoding="utf-8") as f:
                json.dump({"hash": content_hash, "ts": now}, f)
        except Exception:
            pass
        sys.exit(0)

    last_hash = None
    last_ts = 0.0
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            d = json.load(f)
            last_hash = d.get("hash")
            last_ts = float(d.get("ts", 0.0))
    except Exception:
        pass

    # Ignore unchanged clipboard content unconditionally (prevents KDE/Klipper
    # Wayland selection re-offers on window minimize/reopen/focus changes from
    # triggering phantom copy toasts) and debounce rapid bursts within 0.15s.
    if content_hash == last_hash or (now - last_ts < 0.15):
        sys.exit(0)

    # Update state file
    try:
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump({"hash": content_hash, "ts": now}, f)
    except Exception:
        pass

    # 4. Format summary label
    chars = len(content)
    lines = content.count("\n") + 1
    if lines > 1:
        label = f"Copied to clipboard ({lines} lines · {chars} chars)"
    else:
        label = f"Copied to clipboard ({chars} chars)"

    # 5. Trigger KDE Plasma native OSD pill
    try:
        subprocess.run(
            [
                "qdbus6",
                "org.kde.plasmashell",
                "/org/kde/osdService",
                "org.kde.osdService.showText",
                "edit-copy",
                label,
            ],
            check=False,
            timeout=1.0,
        )
    except Exception:
        pass

    # 6. Status Toast on tmux clients (non-modal display-message only)
    try:
        meta = f"{lines} lines · {chars} chars" if lines > 1 else f"{chars} chars"
        tmux_msg = f"#[bg=#20252d,fg=#27ae60,bold] ✓ #[fg=#ecf0f4,bold]Copied to clipboard #[fg=#60a5fa,nobold]({meta}) #[default]"

        res = subprocess.run(
            ["tmux", "list-clients", "-F", "#{client_name}"],
            capture_output=True,
            text=True,
            check=False,
            timeout=0.5,
        )
        if res.returncode == 0:
            for line in res.stdout.strip().splitlines():
                client = line.strip()
                if client:
                    subprocess.run(
                        [
                            "tmux",
                            "display-message",
                            "-c",
                            client,
                            "-d",
                            "1500",
                            tmux_msg,
                        ],
                        check=False,
                        timeout=0.5,
                    )

        # Write to live state for sidebar transient indicator under exclusive flock
        live_state_path = os.path.expanduser("~/.cache/antigravity_live_state.json")
        live_state_lock = os.path.expanduser("~/.cache/antigravity_live_state.lock")
        if os.path.isfile(live_state_path):
            lock_fd = None
            try:
                lock_dir = os.path.dirname(live_state_lock)
                if not os.path.exists(lock_dir):
                    os.makedirs(lock_dir, exist_ok=True)
                lock_fd = os.open(live_state_lock, os.O_CREAT | os.O_RDWR, 0o600)
                fcntl.flock(lock_fd, fcntl.LOCK_EX)

                st = {}
                with open(live_state_path, "r", encoding="utf-8") as f:
                    loaded = json.load(f)
                    if isinstance(loaded, dict):
                        st = loaded
                st["last_copy_toast"] = {"ts": now, "meta": meta}
                tmp_st = f"{live_state_path}.tmp.{os.getpid()}"
                with open(tmp_st, "w", encoding="utf-8") as f:
                    json.dump(st, f, indent=2)
                os.replace(tmp_st, live_state_path)
            except Exception:
                pass
            finally:
                if lock_fd is not None:
                    try:
                        fcntl.flock(lock_fd, fcntl.LOCK_UN)
                    except Exception:
                        pass
                    try:
                        os.close(lock_fd)
                    except Exception:
                        pass
    except Exception:
        pass


if __name__ == "__main__":
    main()
