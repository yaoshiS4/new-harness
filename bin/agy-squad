def preview_command(cmd_id: str) -> None:
    clean_id = cmd_id.strip().split()[0] if cmd_id.strip() else ""
    item = next((it for it in COMMAND_PALETTE_ITEMS if it["id"] == clean_id), None)
    if not item:
        print(f"Unknown command: {cmd_id}")
        return

    print(f"{C_BOLD}{C_PURPLE}=== ANTIGRAVITY COMMAND PALETTE ==={C_RESET}")
    print(f"{C_BOLD}Command:{C_RESET}     {C_BOLD}{C_CYAN}{item['id']}{C_RESET}")
    print(f"{C_BOLD}Action:{C_RESET}      {C_WHITE}{item['title']}{C_RESET}")
    print(f"{C_BOLD}Category:{C_RESET}    {C_YELLOW}{item['category']}{C_RESET}")
    print(f"{C_BOLD}Shortcut:{C_RESET}    {C_GREEN}{item['shortcut']}{C_RESET}")
    print(f"{C_BOLD}Execution:{C_RESET}   {C_COMMENT}{item['target']}{C_RESET}")
    print()
    print(f"{C_BOLD}Description:{C_RESET}")
    print(f"  {item['desc']}")
    print()
    if item["id"] == "attention-jump":
        locked = get_locked_conversation_ids()
        print(f"{C_BOLD}Attention Telemetry:{C_RESET} {len(locked)} locked/active session(s)")
    elif item["id"] == "scoped-diff":
        renderer = get_diff_renderer()
        print(f"{C_BOLD}Active Diff Renderer:{C_RESET} {C_GREEN}{renderer.upper()}{C_RESET}")


def execute_palette_command(cmd_id: str) -> None:
    clean_id = cmd_id.strip().split()[0] if cmd_id.strip() else ""
    if clean_id == "sidebar-toggle":
        toggle_sidebar()
    elif clean_id in ("sidebar-rail", "rail-sidebar"):
        toggle_rail_sidebar()
    elif clean_id == "attention-jump":
        jump_attention()
    elif clean_id == "session-tree":
        tree_popup()
    elif clean_id == "scoped-diff":
        diff_popup()
    elif clean_id == "commit-graph":
        repo_root = get_git_repo_root()
        if shutil.which("serie"):
            subprocess.run(["serie"], cwd=repo_root, check=False)
        else:
            subprocess.run(["git", "-C", repo_root, "log", "--graph", "--oneline", "--all"], check=False)
    elif clean_id == "equalize-splits":
        equalize_splits()
    elif clean_id == "verify-harness":
        subprocess.run(["bash", VERIFY_HARNESS_SCRIPT], check=False)
    elif clean_id == "housekeeping":
        subprocess.run(["python3", os.path.expanduser("~/.gemini/antigravity/scripts/housekeeping.py")], check=False)
    elif clean_id == "sync-repo":
        subprocess.run(["bash", EXPORT_HARNESS_SCRIPT], check=False)


def command_palette(dump_only: bool = False) -> None:
    lines = [f"{it['id']:<17} │ {it['title']}" for it in COMMAND_PALETTE_ITEMS]
    if dump_only:
        for l in lines:
            print(l)
        return

    if not shutil.which("fzf"):
        sys.stderr.write("fzf is required for --command-palette\n")
        return

    squad_bin = SQUAD_BIN
    input_text = "\n".join(lines) + "\n"

    fzf_cmd = [
        "fzf",
        "--ansi",
        "--header=Antigravity Command Palette (Enter: Execute · Alt+p/Esc: Close)",
        "--bind=alt-p:abort,alt-d:abort,alt-t:abort,alt-o:abort,alt-g:abort,alt-y:abort,ctrl-q:abort,esc:abort",
        f"--preview={squad_bin} --preview-command '{{1}}'",
        "--preview-window=right:55%:wrap",
    ]

    res = subprocess.run(fzf_cmd, input=input_text, text=True, capture_output=True)
    if res.returncode == 0 and res.stdout.strip():
        sel_line = res.stdout.strip()
        execute_palette_command(sel_line)


def tree_popup(focus_cid: str = "", dump_only: bool = False) -> None:
    if not os.path.isfile(DB_PATH):
        sys.stderr.write(f"Database not found: {DB_PATH}\n")
        return

    if not dump_only and not shutil.which("fzf"):
        sys.stderr.write("fzf is required for --tree-popup\n")
        return

    if dump_only:
        lines = build_tree_lines(focus_cid=focus_cid)
        print("\n".join(lines))
        return

    squad_bin = SQUAD_BIN
    active_focus = focus_cid

    while True:
        tree_lines = build_tree_lines(focus_cid=active_focus)
        if not tree_lines:
            print("No sessions found in database.")
            break
        input_text = "\n".join(tree_lines) + "\n"

        fzf_cmd = [
            "fzf",
            "--ansi",
            "--header=Antigravity Session & Subagent Tree (Alt+t/Esc: Close, Enter: View, Ctrl-r: Refresh, Ctrl-d: Diff, Ctrl-l: Log, Ctrl-p: Plan)",
            "--bind=alt-p:abort,alt-t:abort,alt-o:abort,alt-d:abort,alt-g:abort,alt-y:abort,ctrl-q:abort,esc:abort",
            f"--bind=ctrl-r:reload({squad_bin} --dump-tree)",
            f"--bind=ctrl-d:execute({squad_bin} --diff-popup)",
            f"--bind=ctrl-l:execute({squad_bin} --tail-transcript '{{-1}}')",
            f"--bind=ctrl-p:execute({squad_bin} --view-plan '{{-1}}')",
            f"--preview={squad_bin} --preview-conversation '{{-1}}'",
            "--preview-window=right:60%:wrap",
        ]
        if active_focus:
            fzf_cmd.append(f"--query={active_focus}")

        res = subprocess.run(fzf_cmd, input=input_text, text=True, capture_output=True)
        active_focus = ""

        if res.returncode != 0 or not res.stdout.strip():
            break

        selected_line = res.stdout.strip()
        m = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", selected_line)
        if m:
            cid = m.group(1)
            view_session_interactive(cid)
        else:
            break


def main() -> None:
    target_session = None
    if "--session" in sys.argv:
        try:
            s_idx = sys.argv.index("--session")
            if s_idx + 1 < len(sys.argv):
                target_session = sys.argv[s_idx + 1]
        except Exception:
            pass
    elif "--target" in sys.argv:
        try:
            s_idx = sys.argv.index("--target")
            if s_idx + 1 < len(sys.argv):
                target_session = sys.argv[s_idx + 1]
        except Exception:
            pass
    bounce = "--bounce" in sys.argv

    if "--toggle-sidebar" in sys.argv:
        toggle_sidebar(session=target_session)
    elif "--ensure-sidebar" in sys.argv:
        toggle_sidebar(ensure_only=True, session=target_session)
    elif "--tree-popup" in sys.argv:
        focus_cid = ""
        if "--focus" in sys.argv:
            try:
                idx = sys.argv.index("--focus")
                if idx + 1 < len(sys.argv):
                    focus_cid = sys.argv[idx + 1]
            except Exception:
                pass
        tree_popup(focus_cid=focus_cid)
    elif "--dump-tree" in sys.argv:
        tree_popup(dump_only=True)
    elif "--inspect-session" in sys.argv:
        args = [a for a in sys.argv[2:] if not a.startswith("-")]
        if not args and len(sys.argv) > 2:
            args = [sys.argv[-1]]
        if args:
            view_session_interactive(args[0])
        else:
            print("Usage: agy-squad --inspect-session <conversation_id>")
    elif "--diff-popup" in sys.argv:
        dump = "--dump" in sys.argv
        scope = "unstaged"
        if "--scope" in sys.argv:
            try:
                idx = sys.argv.index("--scope")
                if idx + 1 < len(sys.argv):
                    scope = sys.argv[idx + 1]
            except Exception:
                pass
        diff_popup(scope=scope, dump_only=dump)
    elif "--diff-list" in sys.argv:
        scope = "unstaged"
        args = [a for a in sys.argv[2:] if not a.startswith("-")]
        if args:
            scope = args[0]
        diff_list(scope)
    elif "--diff-cycle" in sys.argv:
        diff_cycle()
    elif "--diff-toggle-renderer" in sys.argv:
        toggle_diff_renderer()
    elif "--diff-stage" in sys.argv:
        idx = sys.argv.index("--diff-stage")
        tgt_file = sys.argv[idx + 1] if idx + 1 < len(sys.argv) else ""
        if tgt_file:
            stage_toggle_file(tgt_file)
    elif "--preview-diff" in sys.argv:
        args = [a for a in sys.argv[2:] if not a.startswith("--")]
        target_file = args[0] if len(args) > 0 else ""
        scope = args[1] if len(args) > 1 else ""
        preview_diff(target_file, scope)
    elif "--command-palette" in sys.argv:
        dump = "--dump" in sys.argv
        command_palette(dump_only=dump)
    elif "--preview-command" in sys.argv:
        args = [a for a in sys.argv[2:] if not a.startswith("--")]
        target_cmd = args[0] if len(args) > 0 else ""
        preview_command(target_cmd)
    elif "--jump-attention" in sys.argv:
        dump = "--dump" in sys.argv
        jump_attention(dump_only=dump)
    elif "--equalize-splits" in sys.argv:
        equalize_splits(session=target_session, bounce=bounce)
    elif "--rail-sidebar" in sys.argv or "--sidebar-rail" in sys.argv or "--toggle-rail" in sys.argv:
        toggle_rail_sidebar()
    elif "--view-plan" in sys.argv:
        args = sys.argv[2:] if len(sys.argv) > 2 else []
        view_plan(" ".join(args))
    elif "--tail-transcript" in sys.argv:
        args = sys.argv[2:] if len(sys.argv) > 2 else []
        tail_transcript(" ".join(args))
    elif "--preview-conversation" in sys.argv or "--preview-item" in sys.argv:
        args = sys.argv[2:] if len(sys.argv) > 2 else []
        arg_str = " ".join(args)
        preview_conversation(arg_str)
    elif "--run-popup" in sys.argv:
        idx = sys.argv.index("--run-popup")
        if idx + 2 < len(sys.argv):
            k = sys.argv[idx + 1]
            cmd = sys.argv[idx + 2:]
            run_popup(k, cmd)
    elif "--toggle-popup" in sys.argv:
        idx = sys.argv.index("--toggle-popup")
        if idx + 3 < len(sys.argv):
            k = sys.argv[idx + 1]
            cwd = sys.argv[idx + 2]
            cmd = sys.argv[idx + 3:]
            toggle_popup(k, cwd, cmd)
    else:
        print("Usage: agy-squad [--toggle-sidebar | --ensure-sidebar | --sidebar-rail | --tree-popup | --dump-tree | --inspect-session <cid> | --diff-popup | --diff-list | --diff-cycle | --diff-toggle-renderer | --diff-stage <file> | --preview-diff | --command-palette | --preview-command <id> | --jump-attention | --equalize-splits | --run-popup | --toggle-popup]")
        sys.exit(1)


if __name__ == "__main__":
    main()
