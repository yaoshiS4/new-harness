# -----------------------------------------------------------------------------
# 4. Text & Layout Helpers
# -----------------------------------------------------------------------------
def section_header(title: str, width: int, folded: bool = False) -> str:
    """Render a CachyOS Emerald-styled section header with optional fold indicator."""
    fold_tag = f" {C_YELLOW}[+]{C_RESET}" if folded else ""
    prefix = f"{C_GREEN}{C_BOLD}◆ {title}{C_RESET}{fold_tag} "
    pref_len = visible_len(prefix)
    dashes = max(0, width - pref_len)
    return format_line(f"{prefix}{C_COMMENT}{'─' * dashes}{C_RESET}", width)


def fit_category_rows(
    rows: list[str],
    fixed_count: int,
    width: int,
    overflow_noun: str = "more",
    min_count: int = 0,
) -> list[str]:
    """
    Fit rows to budget. Never emit '… +X more' without showing at least 1 actual row.
    """
    if len(rows) > fixed_count:
        if fixed_count <= 1:
            return list(rows[:1]) if fixed_count == 1 else []
        cutoff = max(1, fixed_count - 1)
        overflow_count = len(rows) - cutoff
        res = list(rows[:cutoff])
        res.append(format_line(f" {C_COMMENT}… +{overflow_count} {overflow_noun}{C_RESET}", width))
        return res
    if min_count > 0 and len(rows) < min_count:
        res = list(rows)
        res.extend([""] * (min_count - len(rows)))
        return res
    return list(rows)


def get_terminal_width(fallback: int = 38) -> int:
    if _CLI_WIDTH_OVERRIDE is not None:
        return max(6, _CLI_WIDTH_OVERRIDE)
    cols, _ = shutil.get_terminal_size(fallback=(0, 0))
    if cols > 0:
        return max(6, cols)
    env_cols = os.environ.get("COLUMNS")
    if env_cols:
        try:
            return max(6, int(env_cols))
        except ValueError:
            pass
    return max(6, fallback)


def get_terminal_height(fallback: int = 42) -> int:
    if _CLI_LINES_OVERRIDE is not None:
        return max(8, _CLI_LINES_OVERRIDE)
    _, rows = shutil.get_terminal_size(fallback=(0, 0))
    if rows > 0:
        return max(8, rows)
    env_lines = os.environ.get("LINES")
    if env_lines:
        try:
            return max(8, int(env_lines))
        except ValueError:
            pass
    return max(8, fallback)


