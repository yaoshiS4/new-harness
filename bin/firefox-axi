#!/usr/bin/env python3
"""
firefox-axi - Native Firefox Marionette CLI controller.
Follows the 10 AXI Principles (TOON output, 3-4 fields, aggregates, disclosure).
Zero third-party dependencies (Python 3 stdlib only, Marionette wire protocol v3).
"""

