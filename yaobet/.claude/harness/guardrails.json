{
  "_note": "Yaobet project policy for the Claude Code SOTA Harness. The root thread is the PM and never edits application code; builders (dev-fe, designer, debugger) edit only inside their allowed_files lease.",
  "root_may_edit_code": false,
  "slice_cap": 250,
